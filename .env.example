# Server-side only. Never expose this to the browser.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Ideako asks the Gemini API which models your key can use and
# picks the newest stable Flash model automatically, so you normally don't
# need this. Set it to pin a specific model ID.
# GEMINI_MODEL=

# Optional. Override the API base URL (proxies, local mocks).
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
