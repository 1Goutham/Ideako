# ---------------------------------------------------------------------------
# AI engine. Add at least one key. All of these have a free tier with no card.
# Ideako tries them in order and falls back automatically on rate limits.
# Keys are server-side only and never reach the browser.
# ---------------------------------------------------------------------------

# 1. Google Gemini — best quality for this workload. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq — very fast Llama models, ideal fallback. https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter — many community models with a ":free" tag. https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# 4. Any OpenAI-compatible endpoint (Cerebras, Mistral, Together, local Ollama…)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1
# AI_LABEL=Ollama

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Order of engines, comma-separated. Default: gemini,groq,openrouter,custom
# AI_PROVIDERS=gemini,groq

# Task routing. Default: posts are written on Gemini, hashtags and insights
# run on Groq, each falling back to the other.
# AI_WRITE_PROVIDER=gemini
# AI_ANALYSE_PROVIDER=groq

# Pin a model instead of letting Ideako pick the newest stable one.
# GEMINI_MODEL=
# GROQ_MODEL=
# OPENROUTER_MODEL=

# Override the Gemini base URL (proxies, local mocks).
# GEMINI_API_BASE=https://generativelanguage.googleapis.com
